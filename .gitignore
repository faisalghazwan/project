# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build/tmp output
dist
tmp

# IDE
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS files
Thumbs.db

# testing
test-output

# Firebase service account keys
*-firebase-adminsdk-*.json

# Prisma
prisma/*.db

# Certificates / keys
*.p8
*.p12

# Local MCP config
.mcp.json
.memory
CLAUDE.md

